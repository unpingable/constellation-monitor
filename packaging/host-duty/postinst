#!/bin/sh
# Create the account and layout while leaving activation to the operator.
set -eu
if [ "${1:-}" = configure ]; then
    account=constellation-duty
    if ! getent passwd "$account" >/dev/null; then
        adduser --system --group --home /nonexistent --no-create-home --shell /usr/sbin/nologin "$account"
    fi
    gid=$(getent group "$account" | cut -d : -f 3)
    if [ -z "$gid" ] || [ "$gid" = 0 ] || [ "$(id -u "$account")" = 0 ] ||
        [ "$(id -G "$account")" != "$gid" ]; then
        echo 'constellation-duty must be a non-root account with only its own group' >&2
        exit 1
    fi
    install -d -o "$account" -g "$account" -m 0700 /var/lib/constellation-host-duty
    install -d -o root -g "$account" -m 0750 /etc/constellation-host-duty
fi
if [ -d /run/systemd/system ]; then systemctl daemon-reload; fi
