[Unit]
Description=Constellation bounded remediation consumer (one pass)
Documentation=file:/usr/share/doc/constellation-remediation/README.md
After=local-fs.target time-sync.target
ConditionPathExists=/etc/constellation-remediation/consumer.toml

[Service]
Type=oneshot
# Declared same-root premise (bounded-autonomous-remediation v1): the
# consumer, AG's issuer key, Docket's state and the systemd executor are all
# root. The consumer gains no authority from this: AG admits only the
# owner-pinned plans, Docket derives standing only from the owner's grant.
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/constellation-remediation-consumer --config /etc/constellation-remediation/consumer.toml
# One pass polls a dispatched attempt for at most poll_attempts x interval and
# runs each external command under command_timeout_seconds.
TimeoutStartSec=600
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# systemd's bus (StartUnit, systemd-run, systemctl start) is AF_UNIX. The
# deterministic decider needs nothing else; the model decider's drop-in
# (/usr/share/doc/constellation-remediation/model-decider.conf) adds IP egress.
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/etc/constellation-remediation /etc/nq
# Exactly: consumer state, AG campaign + archive, Docket state, the executor
# attempt store and the grant use journal (all under the first path), and the
# NQ ops store, which SQLite needs writable (-shm) for the resolvers' reads.
ReadWritePaths=/var/lib/constellation-remediation /var/lib/nq-ops
LimitCORE=0
TasksMax=64
MemoryMax=512M
StandardOutput=journal
StandardError=journal
