[Unit]
Description=Constellation filesystem-capacity observation profile
After=local-fs.target
RequiresMountsFor=/var/lib/nq /var/lib/constellation-host-posture
# A runner that keeps losing reactor custody ends as a failed unit.
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
Type=simple
User=nq
Group=nq
UMask=0077
WorkingDirectory=/usr
RuntimeDirectory=nq
RuntimeDirectoryMode=0751
RuntimeDirectoryPreserve=yes
ExecStartPre=/bin/sh -ec 'if /usr/bin/systemctl is-active --quiet nqd.service; then echo "nqd is active; resolve acquisition ownership before activation" >&2; exit 1; fi'
ExecStartPre=/usr/bin/install -d -m 0711 /run/nq/helpers
ExecStartPre=/usr/bin/constellation-host-posture preflight /etc/constellation-host-posture/host-posture.toml
ExecStart=/usr/bin/constellation-host-posture run /etc/constellation-host-posture/host-posture.toml
# One narrow recovery contract: only exit 75, a latched reactor custody
# failure after unknown was published, is restarted, because only there is a
# fresh process the known recovery. Preflight failures, refusals, panics and
# OOM kills are not restarted and stay visible to the owner. Every restart
# counts toward the start limit above.
Restart=no
RestartForceExitStatus=75
RestartSec=30s
TimeoutStopSec=90
KillMode=control-group
OOMPolicy=stop
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
# Same NQ cross-account helper ceiling as the installed nqd service.
# The NQ child launcher clears these capabilities before executing nq-helper.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_KILL
AmbientCapabilities=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_KILL
ReadOnlyPaths=/etc/nq /etc/constellation-host-posture /usr/lib/constellation-host-posture
ReadWritePaths=/var/lib/nq /run/nq /var/lib/constellation-host-posture
LimitNOFILE=4096
LimitFSIZE=512M
LimitCORE=0
TasksMax=128
MemoryMax=1G
MemorySwapMax=0
CPUQuota=100%
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
