{
 "schema": "constellation.estate_registry/v1",
 "site": "labelwatch",
 "note": "Every service Constellation is responsible for on labelwatch-host (192.46.223.21). Inventory taken 2026-10-14 from enabled units, containers and listeners. A service missing here is unsupervised: add it.",
 "services": [
  {
   "name": "driftwatch",
   "role": "atproto observatory",
   "runtime": {
    "docker": "driftwatch"
   },
   "status": {
    "kind": "project-ops-status",
    "timeout_seconds": 90,
    "argv": [
     "docker",
     "exec",
     "driftwatch",
     "python3",
     "-m",
     "labeler.ops_status",
     "--db",
     "/app/data/labeler.sqlite",
     "--data-dir",
     "/app/data",
     "--format",
     "json"
    ]
   },
   "declared": {
    "state": "paused",
    "since": "2026-09-13",
    "reason": "operator pause (DRIFTWATCH_OPERATOR_PAUSED=1, facts export off); ingest and evaluator stopped by design"
   },
   "contract": {
    "concerns": "/etc/constellation-estate/contracts/driftwatch/concerns.toml",
    "revision": "atproto-driftwatch 15a5fdd",
    "sha256": "sha256:d1f31c6e1914b3ac943d0cc46a75aea854acf9c1f1683fdb75f50ed8e8bd9802"
   }
  },
  {
   "name": "weatherwatch",
   "role": "atproto observatory",
   "runtime": {
    "systemd": "weatherwatch-collector.service"
   },
   "status": {
    "kind": "project-ops-status",
    "user": "weatherwatch",
    "cwd": "/opt/weatherwatch/releases/d154848cef330c7a9749dd49a564c18489679906/source",
    "environment": {
     "PYTHONPATH": "src"
    },
    "argv": [
     "/opt/weatherwatch/releases/d154848cef330c7a9749dd49a564c18489679906/venv/bin/python",
     "-m",
     "weatherwatch.visibility",
     "--db",
     "/var/lib/weatherwatch/weatherwatch.sqlite",
     "--report-dir",
     "/var/lib/weatherwatch/build/report",
     "--format",
     "json"
    ]
   },
   "contract": {
    "concerns": "/opt/weatherwatch/releases/d154848cef330c7a9749dd49a564c18489679906/source/.ops/concerns.toml",
    "revision": "weatherwatch d154848",
    "sha256": "sha256:7f098bedaa0646464104e90c6f727e804598c694a45d8c30df9961a818c336b6"
   },
   "timers": [
    "weatherwatch-field.timer",
    "weatherwatch-publish.timer",
    "weatherwatch-social-detect.timer"
   ]
  },
  {
   "name": "labelwatch",
   "role": "atproto observatory (recent epoch)",
   "runtime": {
    "systemd": "labelwatch-recent-product.service"
   },
   "status": {
    "kind": "labelwatch-recent-watch",
    "path": "/var/lib/labelwatch-recent-watch/report.json",
    "max_age_seconds": 900,
    "advisory": [
     "L11"
    ]
   },
   "contract": {
    "waived": "the deployed release's .ops contract describes the retired labelwatch.db architecture; the recent-epoch product's obligations (L1-L11) are acquired through labelwatch-recent-watch. A recent-product .ops contract is owed by the ATProto lane (cartography #90)."
   },
   "timers": [
    "labelwatch-recent-collect.timer",
    "labelwatch-recent-maintain.timer",
    "labelwatch-recent-overview.timer",
    "labelwatch-recent-watch.timer"
   ]
  },
  {
   "name": "factsapi",
   "role": "public facts API",
   "runtime": {
    "systemd": "factsapi.service"
   },
   "status": {
    "kind": "http",
