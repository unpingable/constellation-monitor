   }
  },
  {
   "name": "attention",
   "role": "constellation: attention evaluator (exit 3 = an input not current; its own notice covers that)",
   "runtime": {
    "systemd": "constellation-attention.timer"
   },
   "timers": [
    {
     "unit": "constellation-attention.timer",
     "ok_status": [
      0,
      3
     ],
     "check_result": true
    }
   ]
  },
  {
   "name": "remediation-consumer",
   "role": "constellation: bounded remediation consumer",
   "runtime": {
    "systemd": "constellation-remediation-consumer.timer"
   },
   "timers": [
    {
     "unit": "constellation-remediation-consumer.timer",
     "ok_status": [
      0
     ],
     "check_result": true
    }
   ]
  },
  {
