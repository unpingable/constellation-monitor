  },
  {
   "name": "status-site",
   "role": "constellation: status projection renderer (feeds the exporter)",
   "runtime": {
    "systemd": "constellation-status-site.timer"
   },
   "timers": [
    {
     "unit": "constellation-status-site.timer",
     "ok_status": [
      0
     ],
     "check_result": true
    }
   ]
  },
  {
   "name": "nightshift",
   "role": "constellation: Nightshift observation cycle (failures surface as nightshift-recurrence-missing; same-slot refusals are expected)",
   "runtime": {
    "systemd": "nightshift-observation-cycle.timer"
   },
   "timers": [
    {
     "unit": "nightshift-observation-cycle.timer",
     "ok_status": [
      0
     ],
     "check_result": false
    }
   ]
  }
