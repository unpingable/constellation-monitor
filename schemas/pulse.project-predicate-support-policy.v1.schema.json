{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pulse.project-predicate-support-policy/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_id", "policy_digest", "target", "support_source", "currentness", "nq_verifier_executable_digest"],
  "properties": {
    "schema": {"const": "pulse.project-predicate-support-policy/v1"},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "target": {"type": "object", "additionalProperties": false, "required": ["project", "concern", "question", "declaration_profile", "predicate_profile", "catalog_digest", "profile_digest", "input_schema_digest", "primary_producer", "subject_id"], "properties": {
      "project": {"type": "string"}, "concern": {"type": "string"}, "question": {"type": "string"}, "declaration_profile": {"type": "string"}, "predicate_profile": {"type": "string"},
      "catalog_digest": {"$ref": "#/$defs/digest"}, "profile_digest": {"$ref": "#/$defs/digest"}, "input_schema_digest": {"$ref": "#/$defs/digest"}, "primary_producer": {"type": "string"}, "subject_id": {"type": "string"}
    }},
    "support_source": {"type": "object", "additionalProperties": false, "required": ["producer_id", "producer_key_id", "producer_public_key_hex", "source_id", "vantage_id", "dependency_ids"], "properties": {
      "producer_id": {"type": "string"}, "producer_key_id": {"type": "string"}, "producer_public_key_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source_id": {"type": "string"}, "vantage_id": {"type": "string"}, "dependency_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
    }},
    "currentness": {"type": "object", "additionalProperties": false, "required": ["maximum_primary_age_seconds", "maximum_support_age_seconds", "maximum_primary_support_skew_seconds"], "properties": {
      "maximum_primary_age_seconds": {"type": "integer", "minimum": 1}, "maximum_support_age_seconds": {"type": "integer", "minimum": 1}, "maximum_primary_support_skew_seconds": {"type": "integer", "minimum": 0}
    }},
    "nq_verifier_executable_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
